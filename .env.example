# Copy this file to `.env` or set env vars in your environment
# For Vite, all client-side env vars must start with VITE_
VITE_APP_ENV=development # change to 'production' for production builds
VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-or-domain
VITE_AZURE_REDIRECT_URI=http://localhost:5174
VITE_AZURE_AUTH_FLOW=popup # 'popup' or 'redirect' (use 'redirect' for mobile/strict browsers)
VITE_AZURE_CACHE_LOCATION=sessionStorage # sessionStorage or localStorage
# Optional: Application Insights (set in production only)
# Use the Connection String shown in Azure Monitor for the resource
VITE_APPINSIGHTS_CONNECTION_STRING=

